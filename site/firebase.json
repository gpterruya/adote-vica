{
  "hosting": {
    "public": "dist",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": ["firebase.json", "**/.*"],
    "redirects": [
      { "source": "/page-sitemap.xml", "destination": "/sitemap_index.xml", "type": 301 },
      { "source": "/sitemap.xml", "destination": "/sitemap_index.xml", "type": 301 },
      { "source": "/feed{,/**}", "destination": "/", "type": 301 },
      { "source": "/comments/feed{,/**}", "destination": "/", "type": 301 },
      { "source": "/author/**", "destination": "/", "type": 301 }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
        ]
      },
      {
        "regex": "^/(?:[^.]*|.*\\.(?:html|xml|txt))$",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }]
      },
      {
        "source": "/@(fonts|img)/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
      },
      {
        "source": "/_astro/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      }
    ]
  }
}
