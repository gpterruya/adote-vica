---
// Mapa + rodapé (id="contato", destino do botão "fale com a equipe").
import { site } from '../data/site';
const ano = new Date().getFullYear();
---

<div class="mapa" data-ref="8d6ae95">
	<iframe
		loading="lazy"
		src="https://maps.google.com/maps?q=Adote%20vica&t=m&z=12&output=embed&iwloc=near"
		title="Mapa: Adote Vi.Ca, R. Pamplona, 1481 - Jardins, São Paulo"
		referrerpolicy="no-referrer-when-downgrade"></iframe>
</div>

<footer class="rodape" id="contato" data-ref="4451bd9">
	<div class="wrap rodape__conteudo">
		<div class="rodape__topo" data-ref="f0f5e1d">
			<img class="rodape__logo" src="/img/logo-rodape.svg" alt="Vi.Ca — quem adota muda vidas" width="237" height="206" data-ref="8c67570" />

			<div class="rodape__contato" data-ref="b119f04">
				<h2 class="rodape__titulo">Centro de Adoção Responsável</h2>
				<p>
					<b>Endereço:</b>
					{site.endereco}<br />
					<b>Telefone:</b> <a href={`tel:${site.telefone.e164}`}>{site.telefone.exibicao}</a>
				</p>
			</div>
		</div>

		<hr class="rodape__divisor" data-ref="6193a00" />

		<p class="rodape__copyright" data-ref="cce6fe1">Termo de Adoção Responsável © {ano} Adote Vi.Ca. Todos os direitos reservados.</p>
	</div>
</footer>

<style>
	.mapa iframe {
		display: block;
		width: 100%;
		height: 400px;
		border: 0;
	}

	.rodape {
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		min-height: 586px;
		padding-block: 10px;
		background: var(--bege);
		color: var(--cinza);
	}

	.rodape__conteudo {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 20px;
	}

	.rodape__topo {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 20px;
		width: 100%;
		padding: 10px;
	}

	.rodape__logo {
		height: 237px;
		width: auto;
	}

	.rodape__contato {
		width: 30%;
	}

	.rodape__titulo {
		margin-bottom: 18px;
		font-weight: 700;
		font-size: 22px;
		line-height: 1.5;
		color: var(--cinza);
	}

	.rodape__contato p {
		margin: 0;
		font-size: 18px;
		line-height: 1.5;
	}

	.rodape__contato a {
		color: inherit;
		text-decoration: none;
	}

	.rodape__divisor {
		width: 100%;
		margin: 15px 0;
		border: 0;
		border-top: 1px solid rgb(77 77 77 / 32%);
	}

	.rodape__copyright {
		width: 40%;
		margin: 0;
		font-size: 18px;
		text-align: center;
	}

	@media (max-width: 767px) {
		.mapa iframe {
			height: 250px;
		}

		.rodape {
			min-height: 0;
			/* espaço para o botão flutuante de telefone */
			padding: 64px 0 96px;
		}

		.rodape__topo {
			flex-direction: column;
			justify-content: center;
			gap: 16px;
		}

		.rodape__logo {
			height: 141px;
		}

		.rodape__contato {
			width: 100%;
			text-align: center;
		}

		.rodape__copyright {
			width: auto;
		}
	}
</style>
