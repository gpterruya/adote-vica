---
// Layout de todas as páginas: <head> (SEO, Google Tag Manager, ícones),
// botão flutuante de telefone e estilos globais.
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
}

const { title = site.titulo, description = site.descricao, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/img/fav-icon-vica.png', Astro.site).href;

const schema = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebPage',
			'@id': canonical,
			url: canonical,
			name: title,
			description,
			isPartOf: { '@id': `${Astro.site}#website` },
			inLanguage: 'pt-BR',
		},
		{
			'@type': 'WebSite',
			'@id': `${Astro.site}#website`,
			url: Astro.site?.href,
			name: 'Adote Vi.Ca',
			description: 'Centro de Reabilitação e Adoção Responsável',
			inLanguage: 'pt-BR',
		},
		{
			'@type': 'AnimalShelter',
			name: 'Adote Vi.Ca',
			url: Astro.site?.href,
			telephone: site.telefone.e164,
			address: {
				'@type': 'PostalAddress',
				streetAddress: 'R. Pamplona, 1481 - Jardins',
				addressLocality: 'São Paulo',
				addressRegion: 'SP',
				postalCode: '01405-003',
				addressCountry: 'BR',
			},
		},
	],
};
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta
			name="robots"
			content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
		/>
		{!noindex && <link rel="canonical" href={canonical} />}

		<meta property="og:locale" content="pt_BR" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:site_name" content="Adote Vi.Ca" />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="512" />
		<meta property="og:image:height" content="512" />
		<meta property="og:image:type" content="image/png" />
		<meta name="twitter:card" content="summary_large_image" />

		<!-- Verificação do Google Search Console (mesmo código do Yoast no site antigo) -->
		<meta name="google-site-verification" content={site.googleSiteVerification} />

		<link rel="icon" href="/img/favicon-32.png" sizes="32x32" />
		<link rel="icon" href="/img/favicon-192.png" sizes="192x192" />
		<link rel="apple-touch-icon" href="/img/favicon-192.png" />

		<link rel="preload" href="/fonts/TTHazelnuts-Medium-Trial-BF6401510beb891.ttf" as="font" type="font/ttf" crossorigin />
		<link rel="preload" href="/fonts/IntroScript-Medium.ttf" as="font" type="font/ttf" crossorigin />

		<script type="application/ld+json" set:html={JSON.stringify(schema)} />

		<!-- Google Tag Manager (o Google Ads é carregado por ele) -->
		<script is:inline define:vars={{ gtm: site.gtm }}>
			(function (w, d, s, l, i) {
				w[l] = w[l] || [];
				w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
				var f = d.getElementsByTagName(s)[0],
					j = d.createElement(s),
					dl = l != 'dataLayer' ? '&l=' + l : '';
				j.async = true;
				j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
				f.parentNode.insertBefore(j, f);
			})(window, document, 'script', 'dataLayer', gtm);
		</script>
	</head>
	<body>
		<noscript>
			<iframe
				src={`https://www.googletagmanager.com/ns.html?id=${site.gtm}`}
				height="0"
				width="0"
				style="display:none;visibility:hidden"></iframe>
		</noscript>

		<slot />

		<a class="ligar" href={`tel:${site.telefone.e164}`} aria-label={`Fale conosco por ligação: ${site.telefone.exibicao}`}>
			<svg aria-hidden="true" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg">
				<path
					d="M497.39 361.8l-112-48a24 24 0 0 0-28 6.9l-49.6 60.6A370.66 370.66 0 0 1 130.6 204.11l60.6-49.6a23.94 23.94 0 0 0 6.9-28l-48-112A24.16 24.16 0 0 0 122.6.61l-104 24A24 24 0 0 0 0 48c0 256.5 207.9 464 464 464a24 24 0 0 0 23.4-18.6l24-104a24.290 24.290 0 0 0-14.01-27.6z"
				></path>
			</svg>
			<span class="ligar__texto">Fale conosco por ligação</span>
		</a>
	</body>
</html>

<style>
	/* Botão flutuante de telefone (template 532 no site antigo) */
	.ligar {
		position: fixed;
		right: 20px;
		bottom: 20px;
		z-index: 50;
		display: flex;
		align-items: center;
		gap: 10px;
		min-height: 56px;
		padding: 12px 20px;
		border-radius: 40px;
		background: #000;
		color: #fff;
		font-family: "Poppins", var(--fonte);
		font-weight: 500;
		font-size: 16px;
		line-height: 1;
		text-decoration: none;
		box-shadow: 0 6px 18px rgb(0 0 0 / 18%);
		transition: transform 0.3s;
	}

	.ligar:hover,
	.ligar:focus-visible {
		transform: scale(1.05);
	}

	.ligar svg {
		width: 22px;
		height: 22px;
		fill: currentColor;
		flex: none;
	}

	@media (max-width: 1024px) {
		.ligar {
			right: 16px;
			bottom: 16px;
			width: 56px;
			height: 56px;
			min-height: 0;
			padding: 0;
			justify-content: center;
			border-radius: 50%;
		}

		.ligar__texto {
			display: none;
		}
	}

	@media (max-width: 767px) {
		.ligar {
			right: 12px;
			bottom: 12px;
			width: 48px;
			height: 48px;
		}
	}
</style>
